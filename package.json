{
  "name": "vscode-tason",
  "displayName": "TASON",
  "description": "Syntax highlighting and formatting for TASON",
  "author": "LoveKicher",
  "publisher": "lovekicher",
  "repository": {
    "type": "git",
    "url": "https://github.com/SwingCosmic/vscode-extension-tason"
  },
  "license": "MIT",
  "version": "0.2.0",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "node esbuild.mjs --test",
    "package": "npm run check && npm run test && vsce package --no-dependencies"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:tason"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tason",
        "aliases": [
          "TASON",
          "tason"
        ],
        "extensions": [
          ".tason"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tason",
        "scopeName": "source.tason",
        "path": "./syntaxes/tason.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TASON",
      "properties": {
        "tason.format.tabWidth": {
          "type": ["number", "string", "null"],
          "default": null,
          "minimum": 0,
          "markdownDescription": "缩进宽度，或 `auto`（按文档检测）。留空则不覆盖编辑器已经解析的缩进（含 EditorConfig）。工作区里显式改过的值优先于编辑器；用户级全局值不会盖过编辑器缩进。"
        },
        "tason.format.useTabs": {
          "type": ["boolean", "string", "null"],
          "enum": [true, false, "auto", null],
          "default": null,
          "markdownDescription": "用 tab 缩进。`auto` 按文档行首 tab / 空格的多数决定。留空则跟随编辑器的 insertSpaces。覆盖规则与 `tason.format.tabWidth` 相同。"
        },
        "tason.format.printWidth": {
          "type": ["number", "null"],
          "default": null,
          "minimum": 1,
          "markdownDescription": "单行宽度上限。留空则使用 TASON 默认值 80。"
        },
        "tason.format.singleQuote": {
          "type": ["boolean", "string", "null"],
          "enum": [true, false, "auto", null],
          "default": null,
          "markdownDescription": "字符串用单引号。留空时格式化传入 `auto`（按文档引号个数严格多数，平手用双引号）。"
        },
        "tason.format.quoteKeys": {
          "type": ["string", "null"],
          "enum": ["as-needed", "preserve", null],
          "default": null,
          "markdownDescription": "object key 是否尽量去掉引号。留空为 `as-needed`。"
        },
        "tason.format.trailingComma": {
          "type": ["string", "null"],
          "enum": ["all", "none", null],
          "default": null,
          "markdownDescription": "多行容器是否写尾逗号。留空为 `all`。单行容器不加尾逗号。"
        },
        "tason.format.endOfLine": {
          "type": ["string", "null"],
          "enum": ["lf", "crlf", null],
          "default": null,
          "markdownDescription": "换行符。留空时跟随当前文档的换行。"
        },
        "tason.format.optimizeNumbers": {
          "type": ["boolean", "null"],
          "default": null,
          "markdownDescription": "数值字面量等值规范化。**首版未实现**：设为 true 也不会改变输出。"
        },
        "tason.format.optimizeNumberTypeInstances": {
          "type": ["boolean", "null"],
          "default": null,
          "markdownDescription": "把数值优化扩展到内置数值 TypeName 的标量参数。**首版未实现**。"
        },
        "tason.format.optimizeBlockComments": {
          "type": ["boolean", "null"],
          "default": null,
          "markdownDescription": "按 JS 风格重排块注释。**首版未实现**：注释文字原样保留。"
        }
      }
    }
  },
  "dependencies": {
    "tason": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.68",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.2.2"
  }
}
